<package version="1.0">
    <description>Ethtool tests</description>

    <author mailto="Yurij.Plotnikov@arknetworks.am"/>

    <session track_conf="silent" track_conf_handdown="descendants">

        <var name="env.peer2peer.an_iut_change">
            <value reqs="IP4">
                'net':IUT{
                    'iut_host'{
                        {'iut_rpcs':IUT,if:'iut_if'},
                        addr:'iut_addr':inet:unicast
                    },
                    'tst_host'{
                        {'tst_rpcs':tester},
                        addr:'tst_addr':inet:unicast,
                        if:'tst_if'
                    }
                },
                'changed_rpcs'='iut_rpcs',
                'changed_if'='iut_if',
                'peer_rpcs'='tst_rpcs',
                'peer_if'='tst_if'
            </value>
        </var>

        <var name="env.peer2peer.an_tst_change">
            <value reqs="IP4">
                'net':IUT{
                    'iut_host'{
                        {'iut_rpcs':IUT,if:'iut_if'},
                        addr:'iut_addr':inet:unicast
                    },
                    'tst_host'{
                        {'tst_rpcs':tester},
                        addr:'tst_addr':inet:unicast,
                        if:'tst_if'
                    }
                },
                'changed_rpcs'='tst_rpcs',
                'changed_if'='tst_if',
                'peer_rpcs'='iut_rpcs',
                'peer_if'='iut_if'
            </value>
        </var>

        <run>
            <script name="dev_properties" track_conf="nohistory">
                <req id="X3-ET001"/>
                <req id="X3-ET010"/>
                <req id="IF_DOWN"/>
            </script>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="statistics">
                <req id="X3-ET003"/>
            </script>
            <arg name="env">
                <value ref="env.peer2peer"/>
                <value ref="env.peer2peer_ipv6"/>
            </arg>
            <arg name="sock_type" type="sock_stream_dgram"/>
        </run>

        <run>
            <script name="msglvl" track_conf="nohistory">
                <req id="X3-ET009"/>
                <req id="IF_DOWN"/>
            </script>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="reset_under_traffic" track_conf="nohistory|sync">
                <req id="RESET"/>
                <req id="X3-ET021"/>
            </script>
            <arg name="env">
                <value ref="env.peer2peer"/>
                <value ref="env.peer2peer_ipv6"/>
            </arg>
            <arg name="flags">
                <value>MAC</value>
                <value>DEDICATED</value>
                <value>SHARED_MAC|SHARED_PHY</value>
                <value>ALL</value>
            </arg>
        </run>

        <run>
            <script name="check_ring">
                <req id="X3-ET014"/>
                <req id="X3-ET015"/>
            </script>
            <arg name="env">
                <value ref="env.iut_only"/>
            </arg>
        </run>

        <run>
            <script name="show_pause">
                <req id="X3-ET005"/>
            </script>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="pause_stats_increment"/>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="ts_info">
                <req id="X3-PTP013"/>
            </script>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="register_dump"/>
            <arg name="env">
                <value ref="env.iut_only"/>
            </arg>
        </run>

        <run>
            <script name="eeprom_dump"/>
            <arg name="env">
                <value ref="env.iut_only"/>
            </arg>
        </run>

        <run>
            <script name="dump_module_eeprom"/>
            <arg name="env">
                <value ref="env.iut_only"/>
            </arg>
        </run>

        <run>
            <script name="show_eee"/>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="show_fec"/>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="show_module"/>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="eee"/>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="autoneg_advertise"/>
            <arg name="env">
                <value ref="env.peer2peer.an_iut_change"/>
                <value ref="env.peer2peer.an_tst_change"/>
            </arg>
            <arg name="if_down" type="do_if_down"/>
        </run>

        <run>
            <script name="parallel_detect"/>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
        </run>

        <run>
            <script name="loopback"/>
            <arg name="env">
                <value ref="env.peer2peer"/>
            </arg>
            <arg name="tmpl">
                <value>{
                  pdus {
                    eth:{
                      dst-addr env:{ name "env.addr.tst_lladdr" },
                      src-addr env:{ name "env.addr.iut_lladdr" },
                      length-type plain:8111
                    }
                  }
                }</value>
            </arg>
        </run>

    </session>
</package>
